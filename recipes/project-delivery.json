{
  "name": "project-delivery",
  "description": "Search GitHub, stop for source selection when candidates exist, adapt or build the project, capture evidence, and package it.",
  "steps": [
    {
      "id": "source",
      "module": "task",
      "action": "research",
      "source_policy": "github_first",
      "needs": [],
      "inputs": [
        "request"
      ],
      "outputs": [
        "source.plan"
      ],
      "validator": "source_plan",
      "gate_after": "source"
    },
    {
      "id": "build",
      "module": "task",
      "action": "build",
      "source_policy": "github_first",
      "design_backend": "integrated-impeccable",
      "needs": [
        "source"
      ],
      "inputs": [
        "request",
        "source.plan"
      ],
      "outputs": [
        "project.source",
        "task.result",
        "task.environment"
      ],
      "validator": "artifacts_exist"
    },
    {
      "id": "image",
      "module": "image",
      "action": "capture",
      "design_backend": "integrated-impeccable",
      "needs": [
        "build"
      ],
      "inputs": [
        "project.source",
        "task.result"
      ],
      "outputs": [
        "image.assets"
      ],
      "validator": "artifacts_exist",
      "gate_after": "visual"
    },
    {
      "id": "package",
      "module": "package",
      "action": "assemble",
      "needs": [
        "build",
        "image"
      ],
      "inputs": [
        "project.source",
        "task.result",
        "image.assets"
      ],
      "outputs": [
        "package.bundle",
        "package.manifest"
      ],
      "validator": "package_acceptance"
    }
  ]
}