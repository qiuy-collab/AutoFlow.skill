{
  "name": "report-and-slides",
  "description": "Create shared evidence, then build both a Word report and a presentation before packaging.",
  "steps": [
    {
      "id": "task",
      "module": "task",
      "action": "execute",
      "needs": [],
      "inputs": [
        "request"
      ],
      "outputs": [
        "task.result"
      ],
      "validator": "artifacts_exist"
    },
    {
      "id": "image",
      "module": "image",
      "action": "capture",
      "needs": [
        "task"
      ],
      "inputs": [
        "task.result"
      ],
      "outputs": [
        "image.assets"
      ],
      "validator": "artifacts_exist",
      "gate_after": "visual"
    },
    {
      "id": "word",
      "module": "office",
      "action": "create",
      "needs": [
        "task",
        "image"
      ],
      "inputs": [
        "request",
        "task.result",
        "image.assets"
      ],
      "outputs": [
        "office.document",
        "office.validation"
      ],
      "validator": "office_acceptance",
      "format": "word"
    },
    {
      "id": "ppt",
      "module": "office",
      "action": "create",
      "needs": [
        "task",
        "image"
      ],
      "inputs": [
        "request",
        "task.result",
        "image.assets"
      ],
      "outputs": [
        "office.document",
        "office.validation"
      ],
      "validator": "office_acceptance",
      "gate_after": "visual",
      "format": "ppt"
    },
    {
      "id": "package",
      "module": "package",
      "action": "assemble",
      "needs": [
        "word",
        "ppt"
      ],
      "inputs": [
        "office.document",
        "office.document"
      ],
      "outputs": [
        "package.bundle",
        "package.manifest"
      ],
      "validator": "package_acceptance"
    }
  ]
}