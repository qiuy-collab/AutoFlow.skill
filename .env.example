BASEURL=https://your-image-api-base.example.com
APIKEY=replace-with-real-key
IMAGE_MODEL=gpt-image-2.5
IMAGE_DEFAULT_RESOLUTION=1024x1024
IMAGE_MAX_RETRIES=2
IMAGE_PROBE_RETRIES=1
# Prompt validator: any OpenAI-compatible chat endpoint works.
VALIDATOR_BASEURL=https://your-validator-api.example.com
VALIDATOR_APIKEY=replace-with-real-key
VALIDATOR_MODEL=your-validator-model
# Full prompt validation uses one API call by default; increase only for a flaky upstream.
VALIDATOR_MAX_RETRIES=1
# Optional for endpoints that support OpenAI JSON mode.
# VALIDATOR_RESPONSE_FORMAT=json_object
# Optional OpenAI-compatible reasoning effort, for example low, high, or max.
# VALIDATOR_REASONING_EFFORT=low
# Word authoring backend: officecli, minimaxdocx, or minimax-docx.
OFFICE_WORD_BACKEND=minimaxdocx
# Required only when OFFICE_WORD_BACKEND selects minimaxdocx/minimax-docx.
# MINIMAX_DOCX_ROOT=C:/path/to/minimax-docx
# MINIMAX_DOCX_COMMAND=minimaxdocx
