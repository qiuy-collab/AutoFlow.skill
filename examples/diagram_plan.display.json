      "title": "CampusPulse Class Diagram",
      "classes": [
        {
          "name": "User",
          "attributes": ["-id: Long", "-username: String", "-email: String", "-role: UserRole"],
          "methods": ["+login()", "+logout()", "+updateProfile()"]
        },
        {
          "name": "Student",
          "attributes": ["-studentId: String", "-major: String", "-grade: Integer"],
          "methods": ["+registerActivity()", "+cancelRegistration()", "+viewSchedule()"]
        },
        {
          "name": "Activity",
          "attributes": ["-id: Long", "-title: String", "-capacity: Integer", "-startTime: LocalDateTime", "-location: String"],
          "methods": ["+isFull()", "+getRemainingSlots()"]
        },
        {
          "name": "Registration",
          "attributes": ["-id: Long", "-registeredAt: LocalDateTime", "-status: RegistrationStatus"],
          "methods": ["+confirm()", "+checkIn()"]
        }
      ],
